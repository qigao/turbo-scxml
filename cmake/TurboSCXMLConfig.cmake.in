@PACKAGE_INIT@

if(NOT DEFINED ENV{SALTS_ROOT}
   OR "$ENV{SALTS_ROOT}" STREQUAL "")
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "SALTS_ROOT must name the installed Salts profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" SALTS_ROOT_PATH)
if(NOT IS_DIRECTORY "${SALTS_ROOT_PATH}")
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "SALTS_ROOT is not a directory: $ENV{SALTS_ROOT}")
  return()
endif()

if(NOT DEFINED ENV{SALTS_UTILS_ROOT}
   OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "SALTS_UTILS_ROOT must name the installed SaltsUtils profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" SALTS_UTILS_ROOT_PATH)
if(NOT IS_DIRECTORY "${SALTS_UTILS_ROOT_PATH}")
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "SALTS_UTILS_ROOT is not a directory: $ENV{SALTS_UTILS_ROOT}")
  return()
endif()

include(CMakeFindDependencyMacro)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
find_dependency(Salts 1.2.0 EXACT CONFIG REQUIRED
  PATHS "${SALTS_ROOT_PATH}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

unset(SaltsUtils_DIR CACHE)
unset(SaltsUtils_DIR)
find_dependency(SaltsUtils 2.0.2 EXACT CONFIG REQUIRED
  PATHS "${SALTS_UTILS_ROOT_PATH}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

set(_TURBOSCXML_PACKAGE_WIDE FALSE)
if(NOT TurboSCXML_FIND_COMPONENTS)
  set(_TURBOSCXML_PACKAGE_WIDE TRUE)
endif()

set(_TURBOSCXML_NEEDS_SCXML ${_TURBOSCXML_PACKAGE_WIDE})
foreach(_TURBOSCXML_COMPONENT IN ITEMS
    SCXML CCXML QuickJS CHttpResource CHttpEventIO)
  if(_TURBOSCXML_COMPONENT IN_LIST TurboSCXML_FIND_COMPONENTS)
    set(_TURBOSCXML_NEEDS_SCXML TRUE)
  endif()
endforeach()

set(_TURBOSCXML_NEEDS_CHTTP ${_TURBOSCXML_PACKAGE_WIDE})
if(CHttpResource IN_LIST TurboSCXML_FIND_COMPONENTS OR
   CHttpEventIO IN_LIST TurboSCXML_FIND_COMPONENTS)
  set(_TURBOSCXML_NEEDS_CHTTP TRUE)
endif()

set(_TURBOSCXML_NEEDS_VOICEXML_CMETA FALSE)
if(VoiceXMLCMeta IN_LIST TurboSCXML_FIND_COMPONENTS OR
   (_TURBOSCXML_PACKAGE_WIDE AND
    @TURBOSCXML_PACKAGE_HAS_VOICEXML_CMETA@))
  set(_TURBOSCXML_NEEDS_VOICEXML_CMETA TRUE)
endif()

if(@TURBOSCXML_PACKAGE_HAS_QUICKJS@ AND _TURBOSCXML_NEEDS_SCXML)
  find_dependency(qjs CONFIG REQUIRED)
endif()

if(_TURBOSCXML_NEEDS_SCXML AND NOT TARGET Salts::Databind)
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "The SCXML component requires Salts::Databind from SaltsUtils 2.0.2")
  return()
endif()

if(_TURBOSCXML_NEEDS_CHTTP AND
   (@TURBOSCXML_PACKAGE_HAS_CHTTP_RESOURCE@ OR
    @TURBOSCXML_PACKAGE_HAS_CHTTP_EVENT_IO@))
  if(NOT DEFINED ENV{CHTTP_ROOT}
     OR "$ENV{CHTTP_ROOT}" STREQUAL "")
    set(TurboSCXML_FOUND FALSE)
    set(TurboSCXML_NOT_FOUND_MESSAGE
      "CHTTP_ROOT must name the installed CHTTP profile")
    return()
  endif()
  file(TO_CMAKE_PATH "$ENV{CHTTP_ROOT}" CHTTP_ROOT_PATH)
  if(NOT IS_DIRECTORY "${CHTTP_ROOT_PATH}")
    set(TurboSCXML_FOUND FALSE)
    set(TurboSCXML_NOT_FOUND_MESSAGE
      "CHTTP_ROOT is not a directory: $ENV{CHTTP_ROOT}")
    return()
  endif()
  unset(Chttp_DIR CACHE)
  unset(Chttp_DIR)
  find_dependency(Chttp 1.0.0 EXACT CONFIG REQUIRED
    PATHS "${CHTTP_ROOT_PATH}"
    NO_DEFAULT_PATH)
endif()

set(TurboSCXML_SCXML_FOUND TRUE)
set(TurboSCXML_CCXML_FOUND TRUE)
set(TurboSCXML_VoiceXML_FOUND TRUE)
set(TurboSCXML_VoiceXMLCMeta_FOUND
  @TURBOSCXML_PACKAGE_HAS_VOICEXML_CMETA@)
set(TurboSCXML_QuickJS_FOUND @TURBOSCXML_PACKAGE_HAS_QUICKJS@)
set(TurboSCXML_CHttpResource_FOUND
  @TURBOSCXML_PACKAGE_HAS_CHTTP_RESOURCE@)
set(TurboSCXML_CHttpEventIO_FOUND
  @TURBOSCXML_PACKAGE_HAS_CHTTP_EVENT_IO@)
if(VoiceXMLCMeta IN_LIST TurboSCXML_FIND_COMPONENTS AND
   NOT TurboSCXML_VoiceXMLCMeta_FOUND AND
   TurboSCXML_FIND_REQUIRED_VoiceXMLCMeta)
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "This TurboSCXML package does not include the VoiceXMLCMeta component")
  return()
endif()
if(_TURBOSCXML_NEEDS_CHTTP AND TurboSCXML_CHttpResource_FOUND AND
   NOT TARGET CHttp::Client)
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "The CHttpResource component requires CHttp::Client from the selected "
    "CHTTP package")
  return()
endif()
if(_TURBOSCXML_NEEDS_CHTTP AND TurboSCXML_CHttpEventIO_FOUND)
  set(_TURBOSCXML_MISSING_CHTTP_TARGETS)
  foreach(_TURBOSCXML_REQUIRED_TARGET IN ITEMS
      CHttp::Client CHttp::Server)
    if(NOT TARGET ${_TURBOSCXML_REQUIRED_TARGET})
      list(APPEND _TURBOSCXML_MISSING_CHTTP_TARGETS
        ${_TURBOSCXML_REQUIRED_TARGET})
    endif()
  endforeach()
  if(_TURBOSCXML_MISSING_CHTTP_TARGETS)
    string(JOIN ", " _TURBOSCXML_MISSING_CHTTP_TARGETS_TEXT
      ${_TURBOSCXML_MISSING_CHTTP_TARGETS})
    set(TurboSCXML_FOUND FALSE)
    set(TurboSCXML_NOT_FOUND_MESSAGE
      "The CHttpEventIO component requires these targets from the selected CHTTP package: ${_TURBOSCXML_MISSING_CHTTP_TARGETS_TEXT}")
    return()
  endif()
endif()
if(TurboSCXML_VoiceXML_FOUND AND NOT TARGET Salts::XmlParser)
  set(TurboSCXML_FOUND FALSE)
  set(TurboSCXML_NOT_FOUND_MESSAGE
    "The VoiceXML component requires Salts::XmlParser from the selected "
    "SaltsUtils package")
  return()
endif()
if(_TURBOSCXML_NEEDS_VOICEXML_CMETA AND
   TurboSCXML_VoiceXMLCMeta_FOUND)
  set(_TURBOSCXML_MISSING_VOICEXML_CMETA_TARGETS)
  foreach(_TURBOSCXML_REQUIRED_TARGET IN ITEMS
      Salts::XmlParser Salts::CMeta Salts::QueryVM)
    if(NOT TARGET ${_TURBOSCXML_REQUIRED_TARGET})
      list(APPEND _TURBOSCXML_MISSING_VOICEXML_CMETA_TARGETS
        ${_TURBOSCXML_REQUIRED_TARGET})
    endif()
  endforeach()
  if(_TURBOSCXML_MISSING_VOICEXML_CMETA_TARGETS)
    string(JOIN ", " _TURBOSCXML_MISSING_VOICEXML_CMETA_TARGETS_TEXT
      ${_TURBOSCXML_MISSING_VOICEXML_CMETA_TARGETS})
    set(TurboSCXML_VoiceXMLCMeta_FOUND FALSE)
    if(_TURBOSCXML_PACKAGE_WIDE OR
       TurboSCXML_FIND_REQUIRED_VoiceXMLCMeta)
      set(TurboSCXML_FOUND FALSE)
      set(TurboSCXML_NOT_FOUND_MESSAGE
        "The VoiceXMLCMeta component requires these targets from the selected Salts/SaltsUtils SDKs: ${_TURBOSCXML_MISSING_VOICEXML_CMETA_TARGETS_TEXT}")
      return()
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboSCXMLTargets.cmake")
if(_TURBOSCXML_NEEDS_VOICEXML_CMETA AND
   TurboSCXML_VoiceXMLCMeta_FOUND)
  include(
    "${CMAKE_CURRENT_LIST_DIR}/TurboSCXMLVoiceXMLCMetaTargets.cmake")
endif()
check_required_components(TurboSCXML)
