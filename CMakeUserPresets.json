{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "win-toolchain",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
      }
    },
    {
      "name": "win-paths",
      "hidden": true,
      "inherits": "win-toolchain",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-paths",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "environment": {
        "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": [
        "base-win-dev-user",
        "win-paths"
      ],
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboscxml/debug",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug"
      },
      "environment": {
        "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
        "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "win-release-user",
      "inherits": [
        "base-win-release-user",
        "win-paths"
      ],
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboscxml/release",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows"
      },
      "environment": {
        "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
        "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "linux-dev-user",
      "inherits": [
        "base-linux-dev-user",
        "linux-paths"
      ],
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboscxml/debug",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug"
      },
      "environment": {
        "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
        "PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "linux-release-user",
      "inherits": [
        "release-linux-ninja",
        "linux-paths"
      ],
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboscxml/release",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux"
      },
      "environment": {
        "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
        "PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-build-user",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-build-user",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": "win-build-user",
      "configurePreset": "win-dev-user"
    },
    {
      "name": "win-release-user",
      "inherits": "win-build-user",
      "configurePreset": "win-release-user"
    },
    {
      "name": "linux-dev-user",
      "inherits": "linux-build-user",
      "configurePreset": "linux-dev-user"
    },
    {
      "name": "linux-release-user",
      "inherits": "linux-build-user",
      "configurePreset": "linux-release-user"
    },
    {
      "name": "install-win-dev-user",
      "inherits": "win-build-user",
      "configurePreset": "win-dev-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-win-release-user",
      "inherits": "win-build-user",
      "configurePreset": "win-release-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-linux-dev-user",
      "inherits": "linux-build-user",
      "configurePreset": "linux-dev-user",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-linux-release-user",
      "inherits": "linux-build-user",
      "configurePreset": "linux-release-user",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "win-test-user",
      "hidden": true,
      "inherits": "base-test",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-test-user",
      "hidden": true,
      "inherits": "base-test",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": "win-test-user",
      "configurePreset": "win-dev-user"
    },
    {
      "name": "win-release-user",
      "inherits": "win-test-user",
      "configurePreset": "win-release-user"
    },
    {
      "name": "linux-dev-user",
      "inherits": "linux-test-user",
      "configurePreset": "linux-dev-user"
    },
    {
      "name": "linux-release-user",
      "inherits": "linux-test-user",
      "configurePreset": "linux-release-user"
    }
  ]
}
