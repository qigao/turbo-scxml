<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="p">
  <parallel id="p">
    <state id="s0">
      <transition cond="In(&quot;s1&quot;)" target="pass"/>
      <transition target="fail"/>
    </state>
    <state id="s1"/>
  </parallel>

  <final id="pass">
    <onentry><send event="result.pass"/></onentry>
  </final>
  <final id="fail">
    <onentry><send event="result.fail"/></onentry>
  </final>
</scxml>
