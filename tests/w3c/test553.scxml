<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <onentry>
      <send event="event1" targetexpr="_event.name"/>
      <raise event="after.error"/>
    </onentry>
    <transition event="error.execution" target="verify"/>
    <transition event="event1 after.error" target="fail"/>
  </state>
  <state id="verify">
    <onentry><raise event="verified"/></onentry>
    <transition event="event1 after.error" target="fail"/>
    <transition event="verified" target="pass"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
