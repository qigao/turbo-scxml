<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0"
       name="errorQueueOrdering">
  <state id="s0" initial="s01">
    <state id="s01">
      <onentry>
        <raise event="event1"/>
        <assign location="_name" expr="&quot;changed&quot;"/>
      </onentry>
      <transition event="event1" target="s02"/>
      <transition event="*" target="fail"/>
    </state>
    <state id="s02">
      <onentry><raise event="event2"/></onentry>
      <transition event="error" target="s03"/>
      <transition event="*" target="fail"/>
    </state>
    <state id="s03">
      <transition event="event2" target="pass"/>
      <transition event="*" target="fail"/>
    </state>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
