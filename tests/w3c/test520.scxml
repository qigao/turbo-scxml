<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <onentry>
      <send type="http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor"
            targetexpr="_ioprocessors.basichttp.location">
        <content>this is some content</content>
      </send>
    </onentry>
    <transition event="HTTP.POST" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
