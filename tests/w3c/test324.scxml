<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0"
       name="machineName">
  <state id="s0">
    <transition cond="isBound(_name) &amp;&amp; _name == &quot;machineName&quot;"
                target="s1"/>
    <transition target="fail"/>
  </state>
  <state id="s1">
    <onentry>
      <assign location="_name" expr="&quot;otherName&quot;"/>
      <assign location="sequence" expr="1"/>
    </onentry>
    <transition cond="sequence == 0 &amp;&amp; isBound(_name)"
                target="s2"/>
    <transition target="fail"/>
  </state>
  <state id="s2">
    <transition cond="_name == &quot;machineName&quot;" target="pass"/>
    <transition target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
