<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <onentry>
      <assign location="send_id"
              expr="&quot;http://www.w3.org/TR/scxml/#SCXMLEventProcessor&quot;"/>
      <send event="event1" typeexpr="send_id"/>
    </onentry>
    <transition event="event1" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
