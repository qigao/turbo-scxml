<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="waiting">
  <state id="waiting">
    <onentry>
      <send event="event1" id="foo" delay="1s"/>
      <send event="event2" id="bar" delay="1.5s"/>
      <cancel sendid="foo"/>
    </onentry>
    <transition event="event2" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
