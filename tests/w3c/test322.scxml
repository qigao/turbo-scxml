<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0"
       name="machineName">
  <state id="s0">
    <onentry><assign location="send_id" expr="_sessionid"/></onentry>
    <transition target="s1"/>
  </state>
  <state id="s1">
    <onentry>
      <assign location="_sessionid" expr="&quot;otherName&quot;"/>
      <raise event="unexpected.after.session.write"/>
    </onentry>
    <transition event="error.execution" target="s2"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s2">
    <transition cond="isBound(_sessionid) &amp;&amp; send_id == _sessionid"
                target="pass"/>
    <transition target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
