<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <state id="s0">
    <onentry>
      <send event="test"
            type="http://www.w3.org/TR/scxml/#BasicHTTPEventProcessor"
            targetexpr="_ioprocessors.basichttp.location"/>
      <raise event="internal"/>
    </onentry>
    <transition event="internal" target="s1"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s1">
    <transition event="test" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
