<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="waiting">
  <state id="waiting">
    <onentry>
      <send type="http://www.w3.org/TR/scxml/#SCXMLEventProcessor"
            target="#_scxml_missing" event="event"/>
      <raise event="wrong.queue"/>
    </onentry>
    <transition event="error.communication" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"/>
  <state id="fail"/>
</scxml>
