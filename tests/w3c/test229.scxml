<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" initial="waiting">
  <state id="waiting">
    <invoke type="http://www.w3.org/TR/scxml/" id="child229"
            autoforward="true"/>
    <transition event="childToParent"/>
    <transition event="eventReceived" target="pass"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
