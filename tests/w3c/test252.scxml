<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="invoking">
  <state id="container" initial="invoking">
    <transition event="childToParent" target="fail"/>
    <transition event="done.invoke.invoke252" target="fail"/>
    <transition event="timeout" target="pass"/>
    <transition event="*" target="fail"/>
    <state id="invoking">
      <invoke type="http://www.w3.org/TR/scxml/" id="invoke252"/>
      <transition event="leave" target="observing"/>
    </state>
    <state id="observing"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
