<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="declared">
  <state id="declared">
    <onentry>
      <foreach array="values" item="item" index="index">
        <assign location="previous" expr="item"/>
      </foreach>
      <raise event="declared.done"/>
    </onentry>
    <transition event="declared.done"
                cond="item == 3 &amp;&amp; index == 2 &amp;&amp; previous == 3"
                target="automatic"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="automatic">
    <onentry>
      <foreach array="values" item="auto_item" index="index">
        <assign location="total" expr="auto_item"/>
      </foreach>
      <raise event="automatic.done"/>
    </onentry>
    <transition event="automatic.done"
                cond="auto_item == 3 &amp;&amp; total == 3"
                target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
