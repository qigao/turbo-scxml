<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <state id="s0">
    <onentry>
      <foreach array="values" item="item" index="index">
        <if cond="item == 2 &amp;&amp; index == 1">
          <assign location="total" expr="4294967295"/>
        </if>
        <if cond="item == 3 &amp;&amp; index == 2">
          <raise event="foreach.continued"/>
        </if>
      </foreach>
      <raise event="block.continued"/>
    </onentry>
    <transition event="error.execution"
                cond="total == 0 &amp;&amp; item == 0 &amp;&amp; index == 0"
                target="verify"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="verify">
    <onentry><raise event="check.156"/></onentry>
    <transition event="foreach.continued block.continued" target="fail"/>
    <transition event="check.156" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
