<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <state id="s0">
    <invoke type="http://www.w3.org/TR/scxml/" idlocation="invoke_id"/>
    <invoke type="http://www.w3.org/TR/scxml/" idlocation="send_id"/>
    <transition event="done.invoke.*"
                cond="invoke_id == &quot;s0.1&quot; &amp;&amp;
                      send_id == &quot;s0.2&quot;" target="pass"/>
    <transition event="done.invoke.*" target="fail"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
