<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s1">
  <datamodel>
    <data id="sequence" expr="0"/>
  </datamodel>
  <state id="s1" initial="s11">
    <invoke id="invokeS1" type="urn:w3c:test" src="ancestor"/>
    <transition event="invokeS1" cond="sequence == 0">
      <assign location="sequence" expr="1"/>
    </transition>
    <transition event="invokeS1" target="fail"/>
    <transition event="invokeS12" cond="sequence == 1" target="pass"/>
    <transition event="invokeS12 invokeS11" target="fail"/>
    <state id="s11">
      <invoke id="invokeS11" type="urn:w3c:test" src="transient"/>
      <transition target="s12"/>
    </state>
    <state id="s12">
      <invoke id="invokeS12" type="urn:w3c:test" src="descendant"/>
    </state>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
