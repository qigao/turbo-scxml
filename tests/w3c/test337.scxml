<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="internal">
  <state id="internal">
    <onentry><raise event="internal.check"/></onentry>
    <transition event="internal.check"
                cond="isBound(_event.origintype) &amp;&amp;
                      _event.origintype == &quot;&quot;"
                target="platform"/>
    <transition event="internal.check" target="fail"/>
  </state>
  <state id="platform">
    <onentry><assign location="sequence" expr="_event.data.sequence"/></onentry>
    <transition event="error.execution"
                cond="isBound(_event.origintype) &amp;&amp;
                      _event.origintype == &quot;&quot;"
                target="pass"/>
    <transition event="error.execution" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
