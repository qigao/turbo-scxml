<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <state id="s0">
    <onentry>
      <if cond="isBound(_event)">
        <raise event="bound"/>
        <else/>
        <raise event="unbound"/>
      </if>
    </onentry>
    <transition event="unbound" target="pass"/>
    <transition event="bound" target="fail"/>
  </state>
  <final id="pass">
    <onentry><send event="result.pass"/></onentry>
  </final>
  <final id="fail">
    <onentry><send event="result.fail"/></onentry>
  </final>
</scxml>
