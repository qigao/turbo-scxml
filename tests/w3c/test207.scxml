<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="choose">
  <state id="choose">
    <transition cond="sequence == 1" target="victim"/>
    <transition target="attacker"/>
  </state>
  <state id="victim">
    <onentry><send event="event1" id="foo" delay="1s"/></onentry>
    <transition event="event1" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="attacker">
    <onentry><cancel sendid="foo"/></onentry>
    <transition target="pass"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
