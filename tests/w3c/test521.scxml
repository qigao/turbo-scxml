<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="waiting">
  <state id="waiting">
    <onentry><send event="event2" target="#_scxml_missing"/></onentry>
    <transition event="error.communication" target="pass"/>
    <transition event="event2" target="fail"/>
  </state>
  <final id="pass"/>
  <state id="fail"/>
</scxml>
