<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <datamodel>
    <data id="send_id" expr="&quot;foo&quot;"/>
  </datamodel>
  <state id="s0">
    <onentry>
      <assign location="send_id"
              expr="&quot;file:test216sub1.scxml&quot;"/>
    </onentry>
    <invoke type="http://www.w3.org/TR/scxml/" srcexpr="send_id"/>
    <transition event="done.invoke.*" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
