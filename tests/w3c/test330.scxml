<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="internal">
  <state id="internal">
    <onentry><raise event="internal.check"/></onentry>
    <transition event="internal.check"
                cond="isBound(_event.name) &amp;&amp;
                      isBound(_event.type) &amp;&amp;
                      isBound(_event.sendid) &amp;&amp;
                      isBound(_event.origin) &amp;&amp;
                      isBound(_event.origintype) &amp;&amp;
                      isBound(_event.invokeid) &amp;&amp;
                      isBound(_event.data)"
                target="external"/>
    <transition event="internal.check" target="fail"/>
  </state>
  <state id="external">
    <transition event="external.check"
                cond="isBound(_event.name) &amp;&amp;
                      isBound(_event.type) &amp;&amp;
                      isBound(_event.sendid) &amp;&amp;
                      isBound(_event.origin) &amp;&amp;
                      isBound(_event.origintype) &amp;&amp;
                      isBound(_event.invokeid) &amp;&amp;
                      isBound(_event.data)"
                target="pass"/>
    <transition event="external.check" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
