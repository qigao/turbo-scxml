<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" binding="late" initial="s0">
  <state id="s0">
    <onentry>
      <if cond="sequence == 1"><raise event="observed.too.early"/></if>
    </onentry>
    <transition event="error.execution" target="s1"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s1">
    <datamodel><data id="sequence" expr="1"/></datamodel>
    <onentry><assign location="result" expr="sequence"/></onentry>
    <transition cond="result == sequence" target="pass"/>
    <transition target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
