<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="waiting">
  <state id="waiting">
    <onentry>
      <send event="event1" type="urn:unsupported:event-processor"/>
    </onentry>
    <transition event="error.execution" target="pass"/>
    <transition event="event1" target="fail"/>
  </state>
  <final id="pass"/>
  <state id="fail"/>
</scxml>
