<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="first">
  <state id="first">
    <onentry>
      <send type="http://www.w3.org/TR/scxml/#SCXMLEventProcessor"
            id="send1" event="first.event"/>
    </onentry>
    <transition event="first.event"
                cond="_event.sendid == &quot;send1&quot;"
                target="second"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="second">
    <onentry><send event="second.event"/></onentry>
    <transition event="second.event"
                cond="_event.sendid == &quot;&quot;"
                target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
