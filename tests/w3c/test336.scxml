<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <onentry><send event="foo"/></onentry>
    <transition event="foo"
                cond="_event.origin != &quot;&quot; &amp;&amp; _event.origintype == &quot;http://www.w3.org/TR/scxml/#SCXMLEventProcessor&quot;"
                target="reply"/>
    <transition event="foo" target="fail"/>
  </state>
  <state id="reply">
    <onentry>
      <send event="bar" targetexpr="_event.origin"
            typeexpr="_event.origintype"/>
    </onentry>
    <transition event="bar" target="pass"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
