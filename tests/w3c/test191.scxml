<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="sending">
  <state id="sending">
    <onentry>
      <send type="http://www.w3.org/TR/scxml/#SCXMLEventProcessor"
            target="#_parent" event="childToParent"/>
    </onentry>
    <transition target="done"/>
  </state>
  <final id="done"/>
</scxml>
