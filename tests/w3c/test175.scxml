<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <onentry>
      <assign location="sequence" expr="1000"/>
      <send event="event2" id="later" delayexpr="sequence"/>
      <send event="event1" id="sooner" delay="500ms"/>
    </onentry>
    <transition event="event1" target="delayed"/>
    <transition event="event2" target="fail"/>
  </state>
  <state id="delayed">
    <transition event="event2" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
