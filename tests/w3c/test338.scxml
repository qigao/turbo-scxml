<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <invoke type="urn:w3c:test" idlocation="invoke_id"/>
    <transition event="child.event"
                cond="invoke_id != &quot;&quot; &amp;&amp; _event.invokeid == invoke_id &amp;&amp; _event.type == &quot;external&quot;"
                target="pass"/>
    <transition event="child.event" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
