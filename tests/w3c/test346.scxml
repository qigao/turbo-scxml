<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0"
       name="machineName">
  <state id="s0">
    <onentry>
      <assign location="_sessionid" expr="&quot;otherName&quot;"/>
      <raise event="event1"/>
    </onentry>
    <transition event="error.execution" target="s1"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s1">
    <onentry>
      <assign location="_event" expr="&quot;otherName&quot;"/>
      <raise event="event2"/>
    </onentry>
    <transition event="event1"/>
    <transition event="error.execution" target="s2"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s2">
    <onentry>
      <assign location="_ioprocessors" expr="&quot;otherName&quot;"/>
      <raise event="event3"/>
    </onentry>
    <transition event="event2"/>
    <transition event="error.execution" target="s3"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s3">
    <onentry>
      <assign location="_name" expr="&quot;otherName&quot;"/>
      <raise event="event4"/>
    </onentry>
    <transition event="event3"/>
    <transition event="error.execution" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
