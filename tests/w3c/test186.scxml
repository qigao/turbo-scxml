<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="waiting">
  <state id="waiting">
    <onentry>
      <send event="event1" id="frozen" delay="1s">
        <content expr="sequence"/>
      </send>
      <assign location="sequence" expr="2"/>
    </onentry>
    <transition cond="sequence == 2" target="pass"/>
    <transition target="fail"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
