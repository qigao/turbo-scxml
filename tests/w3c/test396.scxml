<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <state id="s0">
    <onentry><raise event="foo"/></onentry>
    <transition event="foo" cond="_event.name == &quot;foo&quot;"
                target="pass"/>
    <transition event="foo" target="fail"/>
  </state>
  <final id="pass">
    <onentry><send event="result.pass"/></onentry>
  </final>
  <final id="fail">
    <onentry><send event="result.fail"/></onentry>
  </final>
</scxml>
