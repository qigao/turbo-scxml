<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="waiting">
  <state id="waiting">
    <onentry>
      <send event="event2" id="later" delay="1s"/>
      <send event="event1"/>
    </onentry>
    <transition event="event1" target="delayed"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="delayed">
    <transition event="event2" target="pass"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
