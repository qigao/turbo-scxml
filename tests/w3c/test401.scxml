<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="gate"
       name="errorQueuePriority">
  <state id="gate">
    <transition event="start" target="s0"/>
    <transition event="*" target="fail"/>
  </state>
  <state id="s0">
    <onentry>
      <assign location="_name" expr="&quot;changed&quot;"/>
    </onentry>
    <transition event="error" target="pass"/>
    <transition event="foo" target="fail"/>
    <transition event="*" target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
