<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="null" initial="child">
  <state id="child">
    <onentry>
      <send event="childToParent" target="#_parent"
            id="child.delayed" delay="500ms"/>
    </onentry>
    <transition target="pass"/>
  </state>
  <final id="pass"/>
</scxml>
