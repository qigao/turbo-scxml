<?xml version="1.0"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0" datamodel="cmeta" initial="s0">
  <state id="s0">
    <onentry>
      <foreach array="values" item="item" index="index">
        <if cond="item &gt; previous">
          <assign location="previous" expr="item"/>
          <else/>
          <assign location="valid" expr="0"/>
        </if>
      </foreach>
    </onentry>
    <transition cond="valid == 1 &amp;&amp; previous == 3 &amp;&amp; item == 3 &amp;&amp; index == 2" target="pass"/>
    <transition target="fail"/>
  </state>
  <final id="pass"><onentry><send event="result.pass"/></onentry></final>
  <final id="fail"><onentry><send event="result.fail"/></onentry></final>
</scxml>
