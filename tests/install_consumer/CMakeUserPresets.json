{
  "version": 6,
  "include": [
    "../../CMakeUserPresets.json"
  ],
  "configurePresets": [
    {
      "name": "ci-component-installed-user",
      "inherits": "ci-component-release-user",
      "binaryDir": "${sourceDir}/build/component-installed",
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../..",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../vcpkg_installed",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_PLUGIN": "ON",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_COMPONENT": "ON",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_HOST": "ON",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_CNET_EVENT_IO": "ON"
      },
      "environment": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../vcpkg_installed",
        "TURBOSCXML_ROOT": "${sourceDir}/../../stage/sdk/linux-x64",
        "LD_LIBRARY_PATH": "$env{TURBOSCXML_ROOT}/lib${pathListSep}$env{TURBOSCXML_ROOT}/bin${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-component-installed-user",
      "configurePreset": "ci-component-installed-user"
    }
  ],
  "testPresets": [
    {
      "name": "ci-component-installed-user",
      "configurePreset": "ci-component-installed-user",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
