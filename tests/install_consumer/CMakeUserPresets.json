{
  "version": 6,
  "include": [
    "../../CMakeUserPresets.json"
  ],
  "configurePresets": [
    {
      "name": "win-release-quickjs-installed-user",
      "inherits": "win-release-quickjs-user",
      "binaryDir": "${sourceDir}/build/quickjs-installed",
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../..",
        "VCPKG_MANIFEST_FEATURES": "quickjs",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_QUICKJS": "ON"
      },
      "environment": {
        "TURBOSCXML_ROOT": "$penv{TURBOSCXML_ROOT}",
        "PATH": "$env{TURBOSCXML_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "win-release-voicexml-quickjs-installed-user",
      "inherits": "win-release-quickjs-installed-user",
      "binaryDir": "${sourceDir}/build/voicexml-quickjs-installed",
      "cacheVariables": {
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_QUICKJS": "OFF",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_VOICEXML_QUICKJS": "ON"
      }
    },
    {
      "name": "ci-component-installed-user",
      "inherits": "ci-component-release-user",
      "binaryDir": "${sourceDir}/build/component-installed",
      "cacheVariables": {
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../..",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../vcpkg_installed",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_PLUGIN": "ON",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_COMPONENT": "ON",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_HOST": "ON",
        "TURBOSCXML_INSTALL_CONSUMER_EXPECT_CNET_EVENT_IO": "ON"
      },
      "environment": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../vcpkg_installed",
        "TURBOSCXML_ROOT": "${sourceDir}/../../stage/sdk/linux-x64",
        "LD_LIBRARY_PATH": "$env{TURBOSCXML_ROOT}/lib${pathListSep}$env{TURBOSCXML_ROOT}/bin${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-release-voicexml-quickjs-installed-user",
      "configurePreset": "win-release-voicexml-quickjs-installed-user"
    },
    {
      "name": "win-release-quickjs-installed-user",
      "configurePreset": "win-release-quickjs-installed-user"
    },
    {
      "name": "ci-component-installed-user",
      "configurePreset": "ci-component-installed-user"
    }
  ],
  "testPresets": [
    {
      "name": "win-release-voicexml-quickjs-installed-user",
      "configurePreset": "win-release-voicexml-quickjs-installed-user",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "win-release-quickjs-installed-user",
      "configurePreset": "win-release-quickjs-installed-user",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-component-installed-user",
      "configurePreset": "ci-component-installed-user",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
