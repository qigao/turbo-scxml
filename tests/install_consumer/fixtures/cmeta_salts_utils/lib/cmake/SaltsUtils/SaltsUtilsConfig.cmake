if(NOT DEFINED ENV{SALTS_UTILS_CMETA_REAL_ROOT}
   OR "$ENV{SALTS_UTILS_CMETA_REAL_ROOT}" STREQUAL "")
  set(SaltsUtils_FOUND FALSE)
  set(SaltsUtils_NOT_FOUND_MESSAGE
    "SALTS_UTILS_CMETA_REAL_ROOT must name the real SaltsUtils install prefix")
  return()
endif()
if(NOT DEFINED ENV{SALTS_CMETA_REAL_ROOT}
   OR "$ENV{SALTS_CMETA_REAL_ROOT}" STREQUAL "")
  set(SaltsUtils_FOUND FALSE)
  set(SaltsUtils_NOT_FOUND_MESSAGE
    "SALTS_CMETA_REAL_ROOT must name the real Salts install prefix")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_CMETA_REAL_ROOT}"
  SALTS_UTILS_CMETA_REAL_ROOT_PATH)
file(TO_CMAKE_PATH "$ENV{SALTS_CMETA_REAL_ROOT}"
  SALTS_CMETA_REAL_ROOT_PATH)

set(_SALTS_UTILS_CMETA_LIBRARIES)
foreach(_SALTS_UTILS_CMETA_LIBRARY IN ITEMS xml_parser query_vm)
  unset(_SALTS_UTILS_CMETA_LIBRARY_PATH CACHE)
  unset(_SALTS_UTILS_CMETA_LIBRARY_PATH)
  find_library(_SALTS_UTILS_CMETA_LIBRARY_PATH
    NAMES "${_SALTS_UTILS_CMETA_LIBRARY}"
    PATHS "${SALTS_UTILS_CMETA_REAL_ROOT_PATH}/lib"
    NO_DEFAULT_PATH)
  if(NOT _SALTS_UTILS_CMETA_LIBRARY_PATH)
    set(SaltsUtils_FOUND FALSE)
    set(SaltsUtils_NOT_FOUND_MESSAGE
      "The CMeta SaltsUtils fixture cannot find ${_SALTS_UTILS_CMETA_LIBRARY} under "
      "${SALTS_UTILS_CMETA_REAL_ROOT_PATH}/lib")
    return()
  endif()
  list(APPEND _SALTS_UTILS_CMETA_LIBRARIES
    "${_SALTS_UTILS_CMETA_LIBRARY_PATH}")
endforeach()
foreach(_SALTS_UTILS_CMETA_SALTS_LIBRARY IN ITEMS
    salts salts_cmeta salts_coroutine salts_concurrency salts_platform)
  unset(_SALTS_UTILS_CMETA_SALTS_LIBRARY_PATH CACHE)
  unset(_SALTS_UTILS_CMETA_SALTS_LIBRARY_PATH)
  find_library(_SALTS_UTILS_CMETA_SALTS_LIBRARY_PATH
    NAMES "${_SALTS_UTILS_CMETA_SALTS_LIBRARY}"
    PATHS "${SALTS_CMETA_REAL_ROOT_PATH}/lib"
    NO_DEFAULT_PATH)
  if(NOT _SALTS_UTILS_CMETA_SALTS_LIBRARY_PATH)
    set(SaltsUtils_FOUND FALSE)
    set(SaltsUtils_NOT_FOUND_MESSAGE
      "The CMeta SaltsUtils fixture cannot find ${_SALTS_UTILS_CMETA_SALTS_LIBRARY} under "
      "${SALTS_CMETA_REAL_ROOT_PATH}/lib")
    return()
  endif()
  list(APPEND _SALTS_UTILS_CMETA_LIBRARIES
    "${_SALTS_UTILS_CMETA_SALTS_LIBRARY_PATH}")
endforeach()
if(WIN32)
  list(APPEND _SALTS_UTILS_CMETA_LIBRARIES bcrypt)
elseif(UNIX)
  list(APPEND _SALTS_UTILS_CMETA_LIBRARIES m)
endif()

add_library(Salts::QueryVM INTERFACE IMPORTED)
set_target_properties(Salts::QueryVM PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES
    "${SALTS_UTILS_CMETA_REAL_ROOT_PATH}/include/query_vm"
  INTERFACE_LINK_LIBRARIES "${_SALTS_UTILS_CMETA_LIBRARIES}")

add_library(Salts::XmlParser INTERFACE IMPORTED)
set_target_properties(Salts::XmlParser PROPERTIES
  INTERFACE_COMPILE_FEATURES c_std_11
  INTERFACE_INCLUDE_DIRECTORIES
    "${SALTS_UTILS_CMETA_REAL_ROOT_PATH}/include;${SALTS_UTILS_CMETA_REAL_ROOT_PATH}/include/query_vm;${SALTS_CMETA_REAL_ROOT_PATH}/include"
  INTERFACE_LINK_LIBRARIES "${_SALTS_UTILS_CMETA_LIBRARIES}")

set(SaltsUtils_QueryVM_FOUND TRUE)
set(SaltsUtils_XmlParser_FOUND TRUE)
set(SaltsUtils_FOUND TRUE)
